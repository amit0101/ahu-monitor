# Aqueduct PdM — environment variables
# Copy this to .env and fill in values

# OpenAI (required for aQ Assistant panel)
OPENAI_API_KEY=sk-your-key-here

# Simulation tuning (optional overrides)
SIM_SPEED_MULTIPLIER=50.0
SIM_TOTAL_DAYS=90
SIM_AUTO_PLAY=true

# CORS — add your frontend URL if different from default
CORS_ORIGINS=["http://localhost:5173"]
